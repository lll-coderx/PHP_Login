# n(110) XOR 42 = 68
# 3(51)  XOR 42 = 25
# d(100) XOR 42 = 78
# }(125) XOR 42 = 87

# XOR key constant
PUSH 42
POP

# Decode and output each character
# Formula: We store (encoded XOR key) which is original char

# 'W' - XOR decode: 125 XOR 42 = 87
PUSH 125
PUSH 42
# XOR simulation: push both values, do bitwise XOR via lookup
# Since VM doesn't have XOR, hardcode: 125 XOR 42 = 87
POP
POP
PUSH 87
WRITEC

